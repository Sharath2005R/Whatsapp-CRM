# Public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=https://crm.example.com
NEXT_PUBLIC_APP_LOCALE=en

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ENCRYPTION_KEY=replace-with-64-hex-characters
META_APP_SECRET=your-meta-app-secret
AUTOMATION_CRON_SECRET=replace-with-a-long-random-string

# Local AI defaults
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ALLOWED_MODELS=qwen3:4b
OLLAMA_NO_CLOUD=1
OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Feature flags default closed
AI_BUSINESS_TOOLS_ENABLED=0
AI_FOLLOWUPS_ENABLED=0
AI_FOLLOWUP_STORAGE_READY=0
